# ---------------------------------------------------------------------------
# Telix AI Champions – Gemini Enterprise agents – shared configuration
#
#   cp .env.example .env   # then edit the values below
#
# Everything in this file is read by scripts/*.sh.  Nothing here is a secret;
# the file is git-ignored only so that each engineer can keep their own values.
# ---------------------------------------------------------------------------

# GCP project that hosts Agent Runtime + the Gemini Enterprise app.
PROJECT_ID=eg-telix

# Region for Agent Runtime (Reasoning Engine), logs bucket, BigQuery resources.
# Pick a region in the same geography as your Gemini Enterprise app
# (GE app in "eu"  -> europe-west4 / europe-west1,
#  GE app in "us"  -> us-central1,
#  GE app "global" -> us-central1).
REGION=europe-west4

# Full resource name of the Gemini Enterprise app (engine). Leave empty and run
# scripts/bootstrap.sh – it auto-detects the app if there is exactly one.
#   projects/<PROJECT_NUMBER>/locations/<global|us|eu>/collections/default_collection/engines/<APP_ID>
GE_APP_ID=

# GCS bucket for Terraform remote state (created by bootstrap if missing).
TF_STATE_BUCKET=eg-telix-agent-tfstate

# Service account used by Cloud Build to run Terraform + agents-cli.
DEPLOYER_SA_NAME=ge-agent-deployer

# --- Argus only -----------------------------------------------------------
# SEC EDGAR requires a descriptive User-Agent: "<Company> <contact email>".
EDGAR_USER_AGENT="Telix Pharmaceuticals ai-champions@telix.com"

# Bucket for Argus whitepaper PDFs / charts (created by Terraform). Default: <PROJECT_ID>-argus-artifacts
# ARGUS_ARTIFACT_BUCKET=

# --- Optional overrides -------------------------------------------------------
# Extra runtime env vars per agent (semicolon separated, no commas).
# BIOCOMPASS_EXTRA_ENV="IMAGE_SIZE=2K;MAX_CRITIC_ROUNDS=1"
# PAPERBANANA_EXTRA_ENV="IMAGE_SIZE=2K;MAX_CRITIC_ROUNDS=2"
# ARGUS_EXTRA_ENV="ARGUS_SHOW_THOUGHTS=0"
